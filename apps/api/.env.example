# Required for local API startup
NODE_ENV=development
API_PORT=3000

# Browser origin allowed to make credentialed API requests.
WEB_ORIGIN=http://localhost:4200

# Required for MongoDB-backed authentication and wedding setup.
MONGODB_URI=
MONGODB_DATABASE=make_my_marriage

RESEND_API_KEY=
EMAIL_FROM=

# Add credentials only when the corresponding integration is implemented.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_BASE_URL=
# GOOGLE_PLACES_API_KEY=
